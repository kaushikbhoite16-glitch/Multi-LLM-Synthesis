# ====================================================================
# Multi-LLM Response Evaluation and Adaptive Answer Synthesis System
# Environment Configuration
# ====================================================================

# OpenRouter Unified LLM Gateway API Key
# Sign up and obtain key from https://openrouter.ai/keys
# If left empty, system automatically operates in high-fidelity SIMULATION / DEMO MODE
OPENROUTER_API_KEY=

# Base URL for OpenRouter API
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database Connection (Default: local SQLite database; PostgreSQL ready)
# Development (SQLite): sqlite+aiosqlite:///./multi_llm.db
# Production (PostgreSQL): postgresql+asyncpg://postgres:postgres@localhost:5432/multi_llm
DATABASE_URL=sqlite+aiosqlite:///./multi_llm.db

# Default Models
DEFAULT_EVALUATOR_MODEL=google/gemini-2.0-flash-001
DEFAULT_SYNTHESIS_MODEL=anthropic/claude-3.5-sonnet

# Resource & Budget Guardrails
MAX_COST_PER_QUERY=0.50
MAX_TOKENS_PER_QUERY=16000

# Environment Mode: development / production / testing
ENVIRONMENT=development
MOCK_MODE=false
