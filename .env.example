# ====================================================================
# Multi-LLM Response Evaluation and Adaptive Answer Synthesis System
# Environment Configuration Template (.env.example)
# ====================================================================

# --------------------------------------------------------------------
# 1. OpenRouter Unified LLM Gateway Configuration
# --------------------------------------------------------------------
# Sign up and obtain key from https://openrouter.ai/keys
# If left empty, system automatically operates in high-fidelity SIMULATION / DEMO MODE
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --------------------------------------------------------------------
# 2. Database Connection
# --------------------------------------------------------------------
# Development (SQLite local):
DATABASE_URL=sqlite+aiosqlite:///./multi_llm.db
# Production (Render / Neon / Supabase PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>?ssl=require

# --------------------------------------------------------------------
# 3. Hybrid RAG & Knowledge Base Configuration
# --------------------------------------------------------------------
# Directory for persistent ChromaDB vector collections
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Local embedding model (ONNX Runtime all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Web Search API (Optional: Tavily API key from https://tavily.com; DuckDuckGo/Wikipedia fallback used if empty)
TAVILY_API_KEY=your_tavily_api_key_here

# Dynamic web cache TTL in hours
DYNAMIC_WEB_EXPIRATION_HOURS=24

# Reciprocal Rank Fusion constant k (default: 60)
RAG_RRF_K=60

# Standalone Cross-Encoder neural reranking flag
RAG_ENABLE_RERANKER=true
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Document storage directory for uploaded PDFs and text files
DOCUMENT_STORAGE_DIR=./uploaded_documents

# --------------------------------------------------------------------
# 4. Authentication, Security & Administration
# --------------------------------------------------------------------
# JWT secret for token signing (minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin user auto-seeded on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password_in_production

# Google OAuth (Optional: for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Email Delivery (Resend API or SMTP fallback for password reset)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
FRONTEND_URL=http://localhost:5173

# --------------------------------------------------------------------
# 5. Default Models & Resource Guardrails
# --------------------------------------------------------------------
DEFAULT_EVALUATOR_MODEL=google/gemini-2.0-flash-001
DEFAULT_SYNTHESIS_MODEL=anthropic/claude-3.5-sonnet

MAX_COST_PER_QUERY=0.50
MAX_TOKENS_PER_QUERY=16000

ENVIRONMENT=development
MOCK_MODE=false
